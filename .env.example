# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Ключ API реселлера: Ф-бот → Профиль → API-ключ
STEELPROXY_API_KEY=sp_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# STEELPROXY_API_BASE=https://api.steelproxy.com/v1

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=123456789

# Наценка над вашей закупочной ценой, в процентах. Цена округляется вверх до рубля.
MARKUP_PERCENT=30

SHOP_NAME=Proxy Shop

# ---------- Поддержка и документы (нужны банку для эквайринга) ----------
# Контакт поддержки: @username человека (группа не подходит) и/или почта.
SUPPORT_CONTACT=@your_support
SUPPORT_EMAIL=support@example.com
# Кто продаёт — как в договоре с банком: «ИП Иванов Иван Иванович», «Самозанятый Иванов И. И.»…
OPERATOR_NAME=
# ИНН (необязательно, но банки обычно просят)
OPERATOR_INN=
# Дата редакции документов (по умолчанию — дата текущей версии текстов в боте)
# DOCS_DATE=17.10.2026
# ---------- Оплата ----------
# Пополнение криптовалютой через xRocket Pay (как в Тайнике). Пусто — выключено.
# 1) В Telegram: @xRocket → Pay API → «Создать приложение»; в настройках приложения
#    API Version → Current, затем выпустите «API Token» (и «Webhook Token», если нужен вебхук).
# 2) Для проверки без денег: токен из @xrocket_testnet_bot и XROCKET_TESTNET=1.
XROCKET_PAY_TOKEN=
XROCKET_TESTNET=0
# Чем можно платить (коды xRocket через запятую). Сумма — по курсу xRocket, с округлением вверх.
XROCKET_CURRENCIES=USDT,TONCOIN,TRX
# Если xRocket не отдаёт курс к рублю — курс доллара для пересчёта (например 95.5)
RUB_PER_USD=
# Вебхук (необязательно): мгновенное зачисление вместо сверки раз в 30 с.
# Нужен домен с HTTPS, проксирующий на порт контейнера (см. README).
XROCKET_WEBHOOK_URL=
XROCKET_WEBHOOK_SECRET=
XROCKET_WEBHOOK_PORT=8090

# Пополнение переводом по реквизитам с чеком (подтверждает админ). Если задан xRocket,
# а PAYMENT_INFO пустой, — этот способ выключен. \n — перенос строки.
# Пример: PAYMENT_INFO=Переведите сумму на карту 0000 0000 0000 0000 (Иван И.)\nили по СБП на +7 900 000-00-00.
PAYMENT_INFO=
MIN_TOPUP_RUB=100

# Предупреждать админов, когда баланс в Steel Proxy ниже этой суммы (₽)
LOW_BALANCE_RUB=1000

# Часовой пояс для дат в сообщениях
TIMEZONE=Europe/Moscow

# ---------- Прокси (необязательно) ----------
# Если Telegram на сервере заблокирован или работает с перебоями — бот будет ходить
# в api.telegram.org через этот прокси. Форматы:
#   socks5://login:pass@host:port   или   http://login:pass@host:port
# Прокси на самом сервере (вне Docker) указывайте как host.docker.internal, не 127.0.0.1:
#   TELEGRAM_PROXY=socks5://login:pass@host.docker.internal:1080
TELEGRAM_PROXY=

# Прокси для запросов к API Steel Proxy. Обычно не нужен — оставьте пустым.
STEELPROXY_PROXY=
